# Public build configuration; copy to .env. Secrets belong in .dev.vars.
AUTH_ORIGIN=http://localhost:5173

# Blank selects the fixed LOCAL UUID. Deployment requires the real D1 UUID.
D1_DATABASE_ID=
PHOTOS_BUCKET_NAME=photospots-photos

# Optional. Use a production map provider before launch.
MAP_STYLE_URL=

# Required only for email sign-in: a sender on a verified Resend domain.
AUTH_EMAIL_FROM=
