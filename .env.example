# Copy to .env and fill from `npx supabase status -o env`.
# .env is gitignored — never commit real keys, even local ones.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-anon-key-from-supabase-status
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-from-supabase-status

# Optional. Defaults to MapLibre's demo tiles, which are for development only.
MAP_STYLE_URL=
