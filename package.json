{
  "name": "photospots",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || ^26.12.0"
  },
  "scripts": {
    "build": "cf build",
    "dev": "vite",
    "start": "vite preview",
    "typecheck": "cf workers types --no-include-runtime && react-router typegen && tsc",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:runtime": "npm run build && node --import tsx scripts/smoke-worker.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "backfill:scores": "node --import tsx scripts/backfill-scores.ts",
    "refresh:hot": "node --import tsx scripts/refresh-hot-scores.ts",
    "seed": "node --import tsx scripts/seed-grand-rapids.ts",
    "check:deploy": "node --import tsx scripts/check-deploy.ts",
    "predeploy": "npm run check:deploy",
    "deploy": "cf deploy",
    "db:migrate": "node --import tsx scripts/migrate-local.ts",
    "import:legacy": "node --import tsx scripts/import-supabase.ts"
  },
  "dependencies": {
    "better-auth": "1.7.28",
    "isbot": "^5.1.36",
    "maplibre-gl": "^6.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.5.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.5",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@react-router/dev": "8.5.3",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "cf": "1.0.0-rc.5",
    "miniflare": "^5.20261117.0-beta",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.10"
  }
}
